{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youscout.example/contracts/events/user-relation-changed.v1.schema.json",
  "title": "User relationship outbox event v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "eventType",
        "eventVersion",
        "occurredAt",
        "producer",
        "data"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "eventType": {
          "const": "UserRelationChanged"
        },
        "eventVersion": {
          "const": 1
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "const": "user-service"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "actorSubject",
            "targetSubject"
          ],
          "properties": {
            "action": {
              "enum": [
                "FOLLOW",
                "UNFOLLOW",
                "BLOCK",
                "UNBLOCK"
              ]
            },
            "actorSubject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "targetSubject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "eventType",
        "eventVersion",
        "occurredAt",
        "producer",
        "data"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "eventType": {
          "const": "UserRelationshipsSnapshotComplete"
        },
        "eventVersion": {
          "const": 1
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "const": "user-service"
        },
        "data": {
          "type": "object",
          "maxProperties": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "eventType",
        "eventVersion",
        "occurredAt",
        "producer",
        "data"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "eventType": {
          "const": "UserAccountChanged"
        },
        "eventVersion": {
          "const": 1
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "const": "user-service"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject",
            "status"
          ],
          "properties": {
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "status": {
              "enum": [
                "ACTIVE",
                "DEACTIVATED",
                "CLOSING",
                "CLOSED"
              ]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "eventType",
        "eventVersion",
        "occurredAt",
        "producer",
        "data"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "eventType": {
          "const": "UserProfileCreated"
        },
        "eventVersion": {
          "const": 1
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "const": "user-service"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject"
          ],
          "properties": {
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        }
      }
    }
  ],
  "description": "UserAccountChanged (A04) shares the topic and key, so it is ordered with relationship events; consumers hide a DEACTIVATED account's content. U22 adds CLOSING (closure requested, content hidden at once) and CLOSED (closure finished, the account never returns); Feed accepts both since this release, and a consumer must be updated before User emits them. UserProfileCreated (A06) is emitted once, in the transaction that creates a profile, with the subject only; Analytics counts it, Feed and Notification ignore it and must be updated before User emits it."
}
