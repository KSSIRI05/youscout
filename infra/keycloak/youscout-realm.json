{
  "realm": "youscout",
  "enabled": true,
  "displayName": "YouScout local",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "user"
      },
      {
        "name": "admin"
      }
    ]
  },
  "clients": [
    {
      "protocol": "openid-connect",
      "enabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "youscout-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "youscout-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "clientId": "youscout-mobile",
      "publicClient": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:7357/auth/callback",
        "http://127.0.0.1:7357/auth/callback",
        "ma.youscout://oauth/callback"
      ],
      "webOrigins": [
        "http://localhost:7357",
        "http://127.0.0.1:7357"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "protocol": "openid-connect",
      "enabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "youscout-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "youscout-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "clientId": "youscout-smoke",
      "publicClient": false,
      "secret": "${SMOKE_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true
    }
  ]
}
